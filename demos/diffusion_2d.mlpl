# Diffusion on 2D points -- the diffusion algorithm with no conv, no
# pretrained weights: forward-noise a dataset over a schedule, train a
# tiny MLP to predict the added noise, then reverse-sample from pure
# noise back onto the data manifold. Runs on the CPU (browser-friendly).

# ----- data: the two-moons manifold, drop the label column -----
M  = moons(1, 120, 0.08)                       # [120, 3] (x, y, label)
X0 = matmul(M, [[1, 0], [0, 1], [0, 0]])       # [120, 2] points
N  = 120

# ----- noise schedule: linear betas -> alphas -> alpha-bar -----
T     = 12
betas = linspace(0.0001, 0.08, T)              # variance added per step
alphas = 1 - betas
abar  = cumprod(alphas)                         # cumulative product

# ----- build the training set: noise X0 at every timestep t, recording
# the input [x_t, t/T] and the target (the noise that was added) -----
started = 0
TX = fill([1, 3], 0)
TY = fill([1, 2], 0)
t = 0
while gt(T, t) {
  ab   = take(abar, 0, t)                       # alpha-bar at t (scalar)
  eps  = randn(t + 7, [N, 2])                   # the noise to predict
  Xt   = sqrt(ab) * X0 + sqrt(1 - ab) * eps     # forward (noising) process
  tcol = fill([N, 1], t / T)                    # timestep feature
  xin  = concat(Xt, tcol, 1)                    # [N, 3]
  if eq(started, 0) { TX = xin ; TY = eps ; started = 1 } else { TX = concat(TX, xin, 0) ; TY = concat(TY, eps, 0) } ;
  t = t + 1
}
shape(TX)                                        # [T*N, 3]

# ----- the denoiser: a tiny MLP predicting the noise from (point, t) -----
m = chain(linear(3, 64, 0), relu_layer(), linear(64, 2, 1))
experiment "diffusion_2d" { train 200 { adam(mean((apply(m, TX) - TY) * (apply(m, TX) - TY)), m, 0.01, 0.9, 0.999, 0.00000001) ; loss_metric = mean((apply(m, TX) - TY) * (apply(m, TX) - TY)) } }
loss_curve(last_losses)                          # noise-prediction loss falls

# ----- reverse (denoising) process: start from noise, walk t = T-1 .. 0,
# subtract the predicted noise each step (deterministic / DDIM-style) -----
xs = randn(99, [N, 2])
i = 0
while gt(T, i) {
  t    = T - 1 - i
  ab   = take(abar, 0, t)
  a    = take(alphas, 0, t)
  b    = take(betas, 0, t)
  tcol = fill([N, 1], t / T)
  eps  = apply(m, concat(xs, tcol, 1))
  xs   = (xs - (b / sqrt(1 - ab)) * eps) / sqrt(a) ;
  i = i + 1
}
svg(xs, "scatter")                               # generated points (vs the moons)
