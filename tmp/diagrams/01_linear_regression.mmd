---
title: Linear Regression Training Loop
---
flowchart LR

  x("Input features<br/>x")
  w("Weights<br/>w")
  pred("Prediction<br/>y = wx + b")
  loss{"Loss<br/>MSE"}
  grad("Gradient")
  opt("Optimizer<br/>update w,b")

  x --> pred
  w --> pred
  pred --> loss
  loss -.-> grad
  grad -.-> opt
  opt -.->|learn| w

  classDef data fill:#eef,stroke:#668,stroke-width:1px;
  classDef tensor fill:#e8f4ff,stroke:#3973ac,stroke-width:1px;
  classDef op fill:#fff7e6,stroke:#b37700,stroke-width:1px;
  classDef block fill:#f4ecff,stroke:#7e57c2,stroke-width:1px;
  classDef model fill:#ecfff4,stroke:#2e8b57,stroke-width:1px;
  classDef loss fill:#ffecec,stroke:#cc4444,stroke-width:2px;
  classDef grad fill:#fff0f5,stroke:#cc3377,stroke-width:1px;
  classDef memory fill:#f0f0f0,stroke:#666,stroke-width:1px;
  classDef gpu fill:#eefaf8,stroke:#088,stroke-width:1px;
  classDef frozen fill:#f5f5f5,stroke:#999,stroke-dasharray: 5 5;
  classDef adapter fill:#fffbe6,stroke:#aa8800,stroke-width:2px;
  class x data;
  class w tensor;
  class pred op;
  class loss loss;
  class grad grad;
  class opt op;
