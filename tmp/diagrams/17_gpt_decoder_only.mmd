flowchart LR

  prompt("Prompt tokens")
  embed("Token + position embeddings")
  blocks("Repeated causal decoder blocks")
  lmhead("LM head")
  logits("Next-token logits")
  sample("Sample / argmax")
  next("Next token")
  kv[("KV cache")]

  prompt --> embed
  embed --> blocks
  blocks --> lmhead
  lmhead --> logits
  logits --> sample
  sample --> next
  blocks -.->|write| kv
  kv -.->|read| blocks
  next -.->|append| prompt

