#!/usr/bin/env mlpl-repl
# Print the count, sum, and mean of the numeric CLI arguments,
# one value per line.
#
# Usage (the `--` separator is required):
#   mlpl-repl scripts/examples/stats.mlpl -- 10 20 30   # -> 3 / 60 / 20
#   ./scripts/examples/stats.mlpl -- 10 20 30           # after chmod +x
#
# Exit codes: 0 (Ok) on success; 2 with a usage line on stderr
# when given no arguments. Non-numeric args count as 0 (lenient).
#
# Demonstrates: an early-guard if/else with exit(), args() /
# list_len / list_get, to_number, a while loop, and print.

n = list_len(args())
if gt(n, 0) { 0 } else {
  eprint("usage: stats.mlpl -- N [N ...]")
  exit(2)
}
total = 0
i = 0
while gt(n, i) {
  total = total + unwrap_or(to_number(unwrap_or(list_get(args(), i), "0")), 0)
  i = i + 1
}
print(n)
print(total)
print(total / n)
ok(total / n)
