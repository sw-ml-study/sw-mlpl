# checked in themselves -- the tarball is ~792 MB).
/data/
/dist-pages/

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Scratch directory for prereq prompts, drafts, generated diagrams
/tmp/

# Generated HTML from literate Org examples (regenerate with publish.sh)
examples/literate/*.html
