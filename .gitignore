/target/
/dist/
# Saga R1 step 003: services/ workspaces have their
# own target/ trees.
/services/*/target/
/components/*/target/
# trunk dev build output for the web app (deploy uses pages/ +
# dist-pages/, both handled separately).
/components/web/dist/

# Claude Code local state: per-machine settings + runtime locks
# (settings.local.json, scheduled_tasks.lock). Not project source.
# EXCEPTION: .claude/commands/ holds shared slash commands (e.g.
# /mw-cp) that must travel with the repo to every dev machine.
.claude/*
!.claude/commands/

# Build artifacts -- never tracked
*.pdf
*.epub
*.elc

# mdbook build outputs (sources live in books/*/src/, builds are local)
books/dist/
books/*/book/

# Saga 29 step 003: Oxford-IIIT Pet tarball + extracted images
# (used to build the committed pets_tiny.bin fixture, not
# checked in themselves -- the tarball is ~792 MB).
/data/
/dist-pages/

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Scratch directory for prereq prompts, drafts, generated diagrams
/tmp/

# Generated HTML from literate Org examples (regenerate with publish.sh)
examples/literate/*.html
